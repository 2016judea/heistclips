{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo build",
  "outputDirectory": "public",
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/*.js": {
      "includeFiles": "lib/**",
      "maxDuration": 300
    },
    "api/v1/*.js": {
      "includeFiles": "{lib/**,node_modules/ffmpeg-static/ffmpeg}",
      "maxDuration": 300,
      "memory": 3009
    }
  },
  "crons": [
    {
      "path": "/api/refresh",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/autopilot",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/youtube?op=tick",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/tv/:host([a-z0-9]{8,20})/:dir([0-9a-f]{20}_[A-Za-z0-9_]{3,40}_[0-9]{6,16}_[0-9]{6,12})/:path*",
      "destination": "https://:host.cloudfront.net/:dir/:path*"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/openai-apps-challenge",
      "destination": "/api/page?p=/.well-known/openai-apps-challenge"
    },
    {
      "source": "/post",
      "destination": "/api/v1/post"
    },
    {
      "source": "/:lang(de|fr|pt|es)/post",
      "destination": "/api/v1/post?lang=:lang"
    },
    {
      "source": "/oauth/:provider(youtube|tiktok)/callback",
      "destination": "/api/v1/post?op=callback&provider=:provider"
    },
    {
      "source": "/experiences/:id(exp_[A-Za-z0-9]+)/:rest*",
      "destination": "/api/whop?view=exp&id=:id"
    },
    {
      "source": "/experiences/:id(exp_[A-Za-z0-9]+)",
      "destination": "/api/whop?view=exp&id=:id"
    },
    {
      "source": "/dashboard/:id(biz_[A-Za-z0-9]+)/:rest*",
      "destination": "/api/whop?view=dash&id=:id"
    },
    {
      "source": "/dashboard/:id(biz_[A-Za-z0-9]+)",
      "destination": "/api/whop?view=dash&id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/api/page?p=/$1"
    }
  ],
  "redirects": [
    {
      "source": "/rates",
      "destination": "/gta-6-clipping-rates-today",
      "permanent": true
    },
    {
      "source": "/campaigns",
      "destination": "/gta-6-clipping-campaigns",
      "permanent": true
    },
    {
      "source": "/mcp-server",
      "destination": "/connect",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=300, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/tv/(.*)",
      "headers": [
        {
          "key": "x-robots-tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
